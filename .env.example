# Names only. Values belong in STATE_ROOT/private/credentials.env, never in Git.
# init generates local owner and projection keys without printing them.
# LDCON_INSTRUMENT_TOKEN=
# LDCON_PROJECTION_SR422=
# LDCON_PROJECTION_SR1092=
# LDCON_PROJECTION_THF685=
# Optional: agent CLIs use their own login/credential stores.
# LDCON_CLAUDE_BIN=/absolute/path/to/claude
# LDCON_CODEX_BIN=/absolute/path/to/codex
# LDCON_PHYSICAL_LOCK_MANIFEST=/absolute/path/to/verified-host-manifest.json
